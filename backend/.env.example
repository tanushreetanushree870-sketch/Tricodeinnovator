# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string from Supabase:
# Project Settings → Database → Connection string → URI (Transaction pooler)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
JWT_SECRET=your-strong-random-secret-here-min-32-chars
JWT_EXPIRES_IN=7d

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app
MAX_FILE_SIZE_MB=50
CORS_ALLOW_ALL=false
